<robot name = "robot">
    <link name="Torso">
        <inertial>
            <origin xyz="0 0 1.75" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0 0 1.75" rpy="0 0 0"/>
            <geometry>
                <box size="0.5 1 1" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 1.75" rpy="0 0 0"/>
            <geometry>
                <box size="0.5 1 1" />
            </geometry>
        </collision>
    </link>
    <joint name="Torso_LeftArm" type="revolute">
       <parent link="Torso"/>
       <child  link="LeftArm"/>
       <origin rpy="0 0 0" xyz="0 -0.5 1.75" />
       <axis xyz="0 1 0"/>
       <limit effort="0.0" lower="-3.14159" upper="3.14159" velocity="0.0"/>
    </joint>
    <link name="LeftArm">
        <inertial>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.25 0.25" />
            </geometry>
            <material name="pink">
                <color rgba="5 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.25 0.25" />
            </geometry>
        </collision>
    </link>
    <joint name="Torso_RightArm" type="revolute">
