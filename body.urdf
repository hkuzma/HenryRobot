<robot name = "robot">
    <link name="Torso">
        <inertial>
            <origin xyz="0 0 1.8" rpy="0 0 0"/>
            <mass value="1" />
            <inertia ixx="100" ixy="0" ixz="0" iyy="100" iyz="0" izz="100" />
        </inertial>
        <visual>
            <origin xyz="0 0 1.8" rpy="0 0 0"/>
            <geometry>
                <box size="0.5 1 0.5" />
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 1.8" rpy="0 0 0"/>
            <geometry>
                <box size="0.5 1 0.5" />
            </geometry>
        </collision>
    </link>
    <joint name="Torso_LeftUpperArm" type="revolute">
       <parent link="Torso"/>
       <child  link="LeftUpperArm"/>
       <origin rpy="0 0 0" xyz="0.5 -0.5 2.3" />
       <axis xyz="0 1 0"/>
       <limit effort="0.0" lower="-3.14159" upper="3.14159" velocity="0.0"/>
    </joint>
